# Backend environment configuration (development example)
#
# Copy to backend/.env and adjust. Never commit the real .env file.

# Django core
DJANGO_SECRET_KEY=replace-me-with-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Frontend origins (comma-separated)
DJANGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
#   sqlite3    -> local file (default, no further configuration needed)
#   postgresql -> set the variables below
DJANGO_DB_ENGINE=sqlite3
# DJANGO_DB_NAME=wedding_db
# DJANGO_DB_USER=wedding
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432
# DJANGO_DB_CONN_MAX_AGE=60

# Upload ceilings in bytes
MAX_DOCUMENTS_UPLOAD_BYTES=26214400
MAX_IMAGES_UPLOAD_BYTES=10485760

# Auth cookie transport
# Secure cookies require HTTPS; leave False while developing over http.
AUTH_COOKIE_SECURE=False

# Concurrent JWT sessions per user
MAX_CONCURRENT_SESSIONS=3

# Celery / Redis (background reminders)
#   redis://localhost:6379/0        broker
#   redis://localhost:6379/1        result backend
# Run the worker and beat:
#   celery -A wedding_backend worker -l info
#   celery -A wedding_backend beat -l info
# Or deliver due reminders without a worker:
#   python manage.py send_due_reminders
DJANGO_CELERY_BROKER_URL=redis://localhost:6379/0
DJANGO_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Error monitoring (optional)
# SENTRY_DSN=
